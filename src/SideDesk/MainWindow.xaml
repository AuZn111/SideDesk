<Window x:Class="SideDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SideDesk"
        Width="392" Height="720" MinHeight="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextPrimary}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        Closed="Window_Closed"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave">

    <Grid x:Name="Root" Background="Transparent">
        <Border x:Name="PanelRoot"
                Width="392"
                HorizontalAlignment="Right"
                CornerRadius="20,0,0,20"
                Background="{StaticResource PanelGradient}"
                BorderBrush="#2BFFFFFF"
                BorderThickness="1,1,1,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SlideTransform" X="0" />
            </Border.RenderTransform>

            <Grid Margin="18,17,18,13">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Brand -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="LogoBadge" Width="38" Height="38" CornerRadius="11"
                                    Background="{StaticResource AccentGradient}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#7C5CFF" BlurRadius="18" ShadowDepth="0" Opacity="0.45" />
                                </Border.Effect>
                                <Grid Width="19" Height="15">
                                    <Rectangle Width="14" Height="2.6" RadiusX="1.3" RadiusY="1.3"
                                               Fill="White" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                    <Rectangle Width="10" Height="2.6" RadiusX="1.3" RadiusY="1.3"
                                               Fill="#E8FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <Rectangle Width="6" Height="2.6" RadiusX="1.3" RadiusY="1.3"
                                               Fill="#C9FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                </Grid>
                            </Border>

                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="SideDesk" FontSize="16" FontWeight="SemiBold"
                                           Foreground="#F8FAFC" />
                                <TextBlock Text="把桌面留给壁纸" FontSize="10"
                                           Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button x:Name="CollapseButton" Style="{StaticResource IconButton}"
                                    Click="CollapseButton_Click"
                                    AutomationProperties.Name="收起侧栏">
                                <Button.ToolTip>
                                    <ToolTip>收起侧栏</ToolTip>
                                </Button.ToolTip>
                                <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="12" />
                            </Button>

                            <ToggleButton x:Name="PinButton" Style="{StaticResource PinToggle}"
                                          Checked="PinButton_Changed"
                                          Unchecked="PinButton_Changed"
                                          AutomationProperties.Name="固定侧栏">
                                <ToggleButton.ToolTip>
                                    <ToolTip>固定侧栏，不自动收起</ToolTip>
                                </ToggleButton.ToolTip>
                                <TextBlock Text="&#xE718;" Style="{StaticResource Glyph}" FontSize="13" />
                            </ToggleButton>

                            <Button x:Name="MoreButton" Style="{StaticResource IconButton}"
                                    Margin="4,0,0,0" Click="MoreButton_Click"
                                    AutomationProperties.Name="设置与更多操作">
                                <Button.ToolTip>
                                    <ToolTip>设置与更多操作</ToolTip>
                                </Button.ToolTip>
                                <TextBlock Text="&#xE712;" Style="{StaticResource Glyph}" FontSize="15" />
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="SettingsMenu"
                                                 Style="{StaticResource DarkContextMenu}"
                                                 Placement="Bottom"
                                                 Opened="SettingsMenu_Opened">
                                        <MenuItem x:Name="PinMenu" Header="保持展开"
                                                  IsCheckable="True" Click="PinMenu_Click" />
                                        <MenuItem x:Name="StartupMenu" Header="开机自动启动"
                                                  IsCheckable="True" Click="StartupMenu_Click" />
                                        <MenuItem x:Name="HideOnStartMenu" Header="启动时隐藏桌面图标"
                                                  IsCheckable="True" Click="HideOnStartMenu_Click" />
                                        <Separator />
                                        <MenuItem Header="外观设置…" Click="AppearanceMenu_Click" />
                                        <Separator />
                                        <MenuItem x:Name="ToggleIconsMenu" Header="恢复桌面图标"
                                                  Click="ToggleIconsMenu_Click" />
                                        <MenuItem Header="打开桌面文件夹" Click="OpenDesktopMenu_Click" />
                                        <MenuItem Header="刷新图标" Click="RefreshMenu_Click"
                                                  InputGestureText="F5" />
                                        <Separator />
                                        <MenuItem Header="退出 SideDesk" Click="ExitMenu_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Search -->
                    <Border Grid.Row="1" Height="40" Margin="0,17,0,13"
                            Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}"
                                       FontSize="13" Foreground="#7D879B" />

                            <TextBox x:Name="SearchBox" Grid.Column="1"
                                     Style="{StaticResource SearchTextBox}"
                                     AutomationProperties.Name="搜索桌面图标"
                                     TextChanged="SearchBox_TextChanged" />

                            <TextBlock x:Name="SearchPlaceholder" Grid.Column="1"
                                       Text="搜索桌面图标…"
                                       FontSize="12.5"
                                       Foreground="#646F84"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />

                            <Button x:Name="ClearSearchButton" Grid.Column="2"
                                    Style="{StaticResource IconButton}"
                                    Width="22" Height="22" Padding="0"
                                    HorizontalAlignment="Center"
                                    Visibility="Collapsed"
                                    Click="ClearSearchButton_Click"
                                    ToolTip="清除搜索">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="9" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- List heading -->
                    <Grid Grid.Row="2" Margin="3,0,5,9">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="桌面" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#B8C2D4" />
                            <Border x:Name="AccentDot" Width="4" Height="4" CornerRadius="2" Margin="7,1,0,0"
                                    Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="CountText" HorizontalAlignment="Right"
                                   FontSize="10" Foreground="{StaticResource TextMuted}"
                                   Text="正在读取…" />
                    </Grid>

                    <!-- Icon grid -->
                    <Grid Grid.Row="3">
                        <ListBox x:Name="ItemsList"
                                 Style="{StaticResource DesktopList}"
                                 ItemContainerStyle="{StaticResource DesktopTile}"
                                 AutomationProperties.Name="桌面图标"
                                 SelectionMode="Single"
                                 MouseDoubleClick="ItemsList_MouseDoubleClick"
                                 KeyDown="ItemsList_KeyDown"
                                 PreviewMouseRightButtonDown="ItemsList_PreviewMouseRightButtonDown"
                                 ContextMenuOpening="ItemsList_ContextMenuOpening">
                            <ListBox.ContextMenu>
                                <ContextMenu Style="{StaticResource DarkContextMenu}">
                                    <MenuItem Header="打开" Click="OpenContextMenu_Click" />
                                    <MenuItem Header="打开所在位置" Click="OpenLocationContextMenu_Click" />
                                    <MenuItem Header="复制路径" Click="CopyPathContextMenu_Click" />
                                    <Separator />
                                    <MenuItem Header="刷新" Click="RefreshMenu_Click" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="86" ItemHeight="96" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center"
                                                AutomationProperties.Name="{Binding DisplayName}"
                                                AutomationProperties.HelpText="{Binding ToolTipText}">
                                        <Grid Height="38" Margin="0,0,0,5">
                                            <Image Source="{Binding Icon}" Width="36" Height="36"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                        <TextBlock Text="{Binding ShortName}"
                                                   FontSize="10.5"
                                                   LineHeight="14"
                                                   LineStackingStrategy="BlockLineHeight"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Height="28"
                                                   Foreground="#DDE4F0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel x:Name="EmptyState"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Visibility="Visible">
                            <Border Width="56" Height="56" CornerRadius="17"
                                    Background="#12FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="EmptyGlyph" Text="&#xE8B7;"
                                           Style="{StaticResource Glyph}" FontSize="22"
                                           Foreground="{StaticResource AccentSoftBrush}" />
                            </Border>
                            <TextBlock x:Name="EmptyTitle" Text="正在读取桌面…"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"
                                       FontSize="12.5" FontWeight="SemiBold" Foreground="#DCE3F0" />
                            <TextBlock x:Name="EmptySubtitle" Text="桌面上的图标会出现在这里"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"
                                       FontSize="10.5" Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                    </Grid>

                    <!-- Desktop icon status -->
                    <Border Grid.Row="4" Margin="0,12,0,0"
                            Background="{StaticResource CardBrush}" BorderBrush="#16FFFFFF"
                            BorderThickness="1" CornerRadius="11" Padding="11,8">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="6" Height="6"
                                         Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                                <TextBlock x:Name="StatusText" Text="准备中…"
                                           FontSize="10.5" Foreground="#C7D0DF"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="ToggleIconsButton" Style="{StaticResource PillButton}"
                                    Content="显示图标"
                                    AutomationProperties.Name="切换桌面图标显示"
                                    HorizontalAlignment="Right"
                                    Click="ToggleIconsButton_Click" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="5" Margin="2,9,2,0">
                        <TextBlock x:Name="HintText" Text="双击打开 · Ctrl+Alt+D 唤出"
                                   FontSize="9.5" Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="OpenDesktopButton" Style="{StaticResource LinkButton}"
                                Content="打开桌面文件夹"
                                HorizontalAlignment="Right"
                                Click="OpenDesktopButton_Click" />
                    </Grid>
                </Grid>
        </Border>

        <Border x:Name="ArrowTab"
                Width="36"
                Height="58"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                CornerRadius="15,0,0,15"
                Background="{DynamicResource ArrowGradient}"
                BorderBrush="{DynamicResource ArrowBorderBrush}"
                BorderThickness="1,1,0,1"
                Cursor="Hand"
                Visibility="Collapsed"
                AutomationProperties.Name="打开侧边栏"
                MouseLeftButtonUp="ArrowTab_MouseLeftButtonUp">
            <Border.ToolTip>
                <ToolTip>打开侧边栏</ToolTip>
            </Border.ToolTip>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="0" Opacity="0.55" />
            </Border.Effect>
            <Grid>
                <TextBlock Text="&#xE76B;" Style="{StaticResource Glyph}"
                           FontSize="14" Foreground="#FFFFFF" />
            </Grid>
        </Border>
    </Grid>
</Window>
